{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Lox (REPL)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/Lox",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "preLaunchTask": "CMake: Build Debug",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug Lox (current .lox file)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/Lox",
            "args": ["${file}"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "preLaunchTask": "CMake: Build Debug",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}